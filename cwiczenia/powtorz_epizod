"""Ten sam epizod regulatora dwa razy, bez okna: czy wynik jest powtarzalny?"""

import sys

import numpy as np

from rl_journey.baselines import SO101JacobianController
from rl_journey.envs.so101_reach import SO101Reach

seed = int(sys.argv[1])
for proba in range(2):
    env, ctrl = SO101Reach(), SO101JacobianController()
    obs, _ = env.reset(seed=seed)
    for _ in range(env.max_steps):
        action, _ = ctrl.predict(obs)
        obs, _, _, _, info = env.step(action)
    print(
        f"próba {proba}: seed {seed}, cel {np.round(100 * env.goal, 1)} cm, "
        f"koniec {100 * info['distance']:.1f} cm"
    )
